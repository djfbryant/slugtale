{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slugtale",
  "version": "0.1.1",
  "identifier": "com.slugtale.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "Slugtale Settings",
        "width": 480,
        "height": 520,
        "visible": false,
        "resizable": false
      },
      {
        "label": "dictation-bar",
        "url": "dictation-bar.html",
        "title": "Slugtale Dictation",
        "width": 248,
        "height": 76,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "copyright": "Copyright © 2026 djfbryant",
    "shortDescription": "Local voice dictation",
    "longDescription": "Slugtale is a push-to-talk voice dictation tool. Speech is transcribed entirely on your device — audio never leaves the machine — and the transcribed text is typed into whatever app you are using.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/djfbryant/slugtale/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGMkEzRTI0MDA2MEVGRkYKUldULzcyQUFKRDRxNzFlcy9CZlZCMmhRaFlSb000dkFUTW5zaHM1K083WGROWFZGb1VmTmhVQXkK"
    }
  }
}
