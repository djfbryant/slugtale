{
  "name": "slugtale",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-dev.js",
    "dev:raw": "PATH=$HOME/.cargo/bin:$PATH tauri dev --features local-whisper-runtime",
    "build": "PATH=$HOME/.cargo/bin:$PATH tauri build --features local-whisper-runtime",
    "test": "node --test tests/*.test.mjs && cd src-tauri && $HOME/.cargo/bin/cargo test --lib"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
